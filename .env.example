# Copy to .env (git-ignored) and fill in. Never commit real secrets.
# The app reads these via python-dotenv (loaded at startup).

# --- AI provider (optional; can also be set in Admin -> AI Models) ---
GOOGLE_API_KEY=
# GEMINI_API_KEY=            # alias accepted for Google

# --- Oracle HCM (optional; usually configured in Admin -> Data Sources) ---
HCM_BASE_URL=

# --- server ---
HOST=127.0.0.1              # bind address (loopback by default)
PORT=8000
